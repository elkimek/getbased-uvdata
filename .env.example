# getbased-uvdata configuration

# CAMS Atmosphere Data Store credentials. Register at
# https://atmosphere.copernicus.eu/data/registration and accept the dataset
# license for "CAMS global atmospheric composition forecasts" before use.
CAMS_API_URL=https://ads.atmosphere.copernicus.eu/api
CAMS_API_KEY=

# Bearer token clients must present in the Authorization header. Leave
# unset for an open public instance (NOT recommended — there's nothing
# stopping randoms from billing your CAMS quota).
GETBASED_UVDATA_BEARER=

# Per-source cap for authenticated data/metrics routes. The default allows
# normal app bursts while bounding a leaked-token abuse loop.
UVDATA_RATE_LIMIT_PER_MINUTE=300
UVDATA_CLIENT_IP_HEADER=

# Region of interest for the CAMS pull. Default is global. Smaller box
# = faster pull + smaller in-memory grid; pick what your users actually
# need. Format: north,west,south,east (degrees).
CAMS_BBOX=90,-180,-90,180

# Pull cadence (seconds). CAMS publishes new forecasts every 12h; 6h
# strikes a balance between freshness and CDS-API quota burn.
CAMS_PULL_INTERVAL_SEC=21600

# Forecast horizon. CAMS publishes up to 120h (5 days). Lower it for
# smaller payloads on bandwidth-constrained instances; minimum 24h.
CAMS_FORECAST_HORIZON_HOURS=120

# Override the forecast date the server requests from CAMS. Leave empty
# in production — the server uses yesterday's UTC date so the daily forecast
# is guaranteed to have completed publication. Set to YYYY-MM-DD
# when running on a clock-shifted dev box (CDS rejects future dates with
# 400 'invalid combination'). Example: CAMS_DATE_OVERRIDE=2024-06-01
CAMS_DATE_OVERRIDE=

# Listen address.
HOST=0.0.0.0
PORT=8324

# Directory to persist the latest CAMS snapshot to disk. On process
# restart the server warm-starts from this file instead of waiting
# 30 s – 5 min for a fresh CDS-API queue. Defaults to /data (matches
# the docker-compose volume); set to empty string to disable persistence.
CAMS_CACHE_DIR=/data

# Allow merging Open-Meteo (clouds/temp/UVI) into responses so a single
# upstream call from the browser gets everything. Set to 0 to make this
# a CAMS-only relay (browser then merges with its own Open-Meteo fetch).
MERGE_OPENMETEO=1

# Request-line access logs are disabled by default because the legacy GET
# endpoints contain coordinates in the URL. Metrics remain available at the
# bearer-protected /metrics endpoint. Set to 1 only if your logging policy
# safely excludes or redacts query strings.
UVICORN_ACCESS_LOG=0
